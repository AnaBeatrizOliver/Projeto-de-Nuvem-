# Copie para .env na EC2 e preencha. O arquivo .env NUNCA vai para o repositório (RNF-02).

# Banco de dados (RDS MySQL)
DB_HOST=vetcare-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=troque-pela-senha-do-rds
DB_NAME=vetcare

# Servidor
PORT=80

# Fotos dos pets (RF-02) - bucket privado; as credenciais vêm do LabInstanceProfile da EC2
AWS_REGION=us-east-1
BUCKET_FOTOS=vetcare-fotos-5j11-2026

# Relatório (RF-04) - endereço da rota no API Gateway
RELATORIO_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/relatorios/consultas-por-veterinario
